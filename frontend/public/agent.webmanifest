{
  "name": "NyaFie Agent",
  "short_name": "NyaFie Agent",
  "description": "Manage your listings, enquiries, viewings and messages on NyaFie.",
  "id": "/agent/",
  "start_url": "/agent/dashboard?source=app",
  "scope": "/agent/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#5a1d7e",
  "lang": "en-GH",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png?v=2", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png?v=2", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png?v=2", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My properties", "url": "/agent/properties?source=app", "icons": [{ "src": "/icons/icon-192.png?v=2", "sizes": "192x192" }] },
    { "name": "Inquiries", "url": "/agent/inquiries?source=app", "icons": [{ "src": "/icons/icon-192.png?v=2", "sizes": "192x192" }] },
    { "name": "Messages", "url": "/agent/messages?source=app", "icons": [{ "src": "/icons/icon-192.png?v=2", "sizes": "192x192" }] }
  ]
}
