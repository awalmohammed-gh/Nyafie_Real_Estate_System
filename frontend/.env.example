VITE_API_URL=
VITE_PUBLIC_SITE_URL=
# Same value as the backend. Only its SHA-256 hash is built into the app (no VITE_ prefix on purpose).
ADMIN_ENTRY_PATH=
# Optional: map tiles for nearby discovery. Default: OpenStreetMap's standard tiles (fair use).
# Use a commercial/self-hosted {z}/{x}/{y} tile URL (and its required attribution) at scale.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
