{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci --include=dev",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/:path([^.]*)", "destination": "/index.html" }]
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "app.js",
      "installCommand": "npm ci",
      "bindings": [{ "type": "service", "service": "frontend", "format": "url", "env": "FRONTEND_INTERNAL_URL" }]
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "backend" } },
    { "source": "/robots.txt", "destination": { "service": "backend" } },
    { "source": "/sitemap:part(.*).xml", "destination": { "service": "backend" } },
    { "source": "/house/:id", "destination": { "service": "backend" } },
    { "source": "/agents/:id", "destination": { "service": "backend" } },
    { "source": "/agent/:path*", "destination": { "service": "backend" } },
    { "source": "/admin/:path*", "destination": { "service": "backend" } },
    { "source": "/account/:path*", "destination": { "service": "backend" } },
    { "source": "/checkout/:path*", "destination": { "service": "backend" } },
    { "source": "/payment/:path*", "destination": { "service": "backend" } },
    { "source": "/make-offer/:id", "destination": { "service": "backend" } },
    { "source": "/", "destination": { "service": "backend" } },
    { "source": "/:path([^.]*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
