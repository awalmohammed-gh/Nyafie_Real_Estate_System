PORT=
NODE_ENV=
MONGODB_URI=
MONGODB_DB=
PUBLIC_SITE_URL=
CLIENT_URL=
JWT_KEY=
COOKIE_SAME_SITE=
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PSD=
# Paystack: "test" (default) or "live". Live also needs sk_live_/pk_live_ keys and CRON_SECRET.
# Test_Secret_Key / Test_Public_Key are still read for test mode if these are empty.
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# 32+ random characters; authenticates the scheduled payment recovery endpoint.
CRON_SECRET=
# Private admin console address: https://<site>/<ADMIN_ENTRY_PATH>/login. 16-64 letters, digits, - or _.
# Use the same value in the frontend (frontend/.env). Unset: no admin console; /admin never works.
ADMIN_ENTRY_PATH=
ADMIN_WHATSAPP_NUMBER=
TRUST_PROXY=
# Optional property view tracking settings (default: key derived from JWT_KEY, 24 hour window)
VIEW_HASH_SECRET=
VIEW_WINDOW_HOURS=
# Google SMTP: full Gmail/Workspace address and a Google App Password (not your account password).
# Enable 2-Step Verification in the Google account before generating the app password.
SMTP_USER=
SMTP_APP_PASSWORD=
# Google Identity Services OAuth client ID (Web application). Separate from SMTP credentials.
GOOGLE_CLIENT_ID=
# FRONTEND_INTERNAL_URL is injected by the Vercel service binding (also under `vercel dev`); do not set it.
# Optional: place search for nearby discovery. Defaults to OpenStreetMap's public Photon service
# (https://photon.komoot.io/api, fair use). Point it at a self-hosted or paid Photon-compatible URL at scale.
# A key in this URL stays on the server: it is never sent to browsers, returned, logged or followed to redirects.
GEOCODER_URL=
