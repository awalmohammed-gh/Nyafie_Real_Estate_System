PORT=4000
MONGODB_URI=mongodb://localhost:27017/RealEstate
# Trusted frontend origin(s), comma-separated (e.g. https://homebase.com.gh,https://www.homebase.com.gh)
CLIENT_URL=http://localhost:5173

# Cloudinary (property photos)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_SECRET_KEY=

# Auth
# At least 32 random characters (production refuses to start otherwise):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_KEY=
ADMIN_EMAIL=
# Bootstrap admin password: long and unique; change it in Admin Settings after the first sign-in
ADMIN_PSD=

# Paystack TEST keys (server only). Only sk_test_ keys are accepted; without one, online payments are disabled.
# The browser is redirected to Paystack checkout, so the public key is not needed by the frontend.
Test_Secret_Key=
Test_Public_Key=

# Public WhatsApp number for HomeBase (admin) listings, e.g. 233241529904
ADMIN_WHATSAPP_NUMBER=

# Production
# NODE_ENV=production enables secure cookies, HSTS and the JWT_KEY length check
NODE_ENV=development
# Set to 1 when running behind a reverse proxy / load balancer (Render, Railway, Nginx) so rate limits see real client IPs
TRUST_PROXY=
